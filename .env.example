# Required for the live agent (the /agent page and "Run agent" button).
# Get a free key at https://aistudio.google.com/apikey
# This is read server-side only (app/api/agent/route.ts) and is never sent
# to the browser.
GEMINI_API_KEY=

# Optional: override the default model.
# GEMINI_MODEL=gemini-3.7-flash

# Everything else in LifeOps (all five mini-apps, the WebMCP inspector,
# manual "Try tool" testing) works with no environment variables at all.
